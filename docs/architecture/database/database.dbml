
Project task_management {
  database_type: 'PostgreSQL'
}

Enum space_role {
  GUEST
  MEMBER
  OWNER
}

Enum invitation_state {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

Enum status_kind {
  INITIAL
  INTERMEDIATE
  FINAL
}

Enum task_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

Enum assignment_source {
  DIRECT
  SELF_CLAIM
}

Enum account_token_kind {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_PASSWORD
}

Enum task_change_kind {
  CREATED
  UPDATED
}

// Users

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  username citext [not null, unique]
  display_name varchar(100) [not null]
  email citext [not null, unique]
  password_hash varchar(255) [not null]
  email_verified_at timestamptz
  avatar_storage_key varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table account_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  kind account_token_kind [not null]
  token_hash varchar(255) [not null, unique]
  proposed_email citext
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, kind)
  }
}

// Spaces and memberships

Table spaces {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table space_memberships {
  space_id uuid [not null]
  user_id uuid [not null]
  role space_role [not null]
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (space_id, user_id) [pk]
    (space_id, role)
    (user_id, joined_at)
  }
}

Table space_invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  space_id uuid [not null]
  invited_user_id uuid [not null]
  invited_by_user_id uuid
  proposed_role space_role [not null]
  state invitation_state [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    (invited_user_id, state)
    (space_id, state)
  }
}

// Custom statuses and tags

Table task_statuses {
  id uuid [pk, default: `gen_random_uuid()`]
  space_id uuid [not null]
  name varchar(100) [not null]
  kind status_kind [not null]
  position int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (space_id, id) [unique]
    (space_id, position) [unique]
  }

  checks {
    `position >= 0` [name: 'task_status_position_nonnegative']
  }
}

Table space_tags {
  id uuid [pk, default: `gen_random_uuid()`]
  space_id uuid [not null]
  name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (space_id, id) [unique]
    (space_id, name) [unique]
  }
}

// Tasks

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  space_id uuid [not null]
  creator_user_id uuid
  assignee_user_id uuid
  status_id uuid [not null]
  title varchar(255) [not null]
  description text
  deadline_at timestamptz
  priority task_priority [not null, default: 'MEDIUM']
  assignee_can_edit boolean [not null, default: false]
  assignment_source assignment_source
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (space_id, id) [unique]
    (space_id, status_id)
    (space_id, assignee_user_id)
    (space_id, deadline_at)
    (space_id, created_at)
  }

  checks {
    `(assignee_user_id IS NULL AND assignment_source IS NULL) OR (assignee_user_id IS NOT NULL AND assignment_source IS NOT NULL)` [name: 'task_assignment_consistency']
    `length(trim(title)) > 0` [name: 'task_title_not_blank']
  }
}

// Many-to-many: tasks and tags

Table task_tags {
  space_id uuid [not null]
  task_id uuid [not null]
  tag_id uuid [not null]

  indexes {
    (task_id, tag_id) [pk]
    (space_id, tag_id)
  }
}

// Task history

Table task_changes {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null]
  actor_user_id uuid
  kind task_change_kind [not null]
  changed_fields jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (task_id, created_at)
  }
}

// Relationships

Ref: account_tokens.user_id > users.id [delete: cascade]

Ref: space_memberships.space_id > spaces.id [delete: cascade]
Ref: space_memberships.user_id > users.id [delete: cascade]

Ref: space_invitations.space_id > spaces.id [delete: cascade]
Ref: space_invitations.invited_user_id > users.id [delete: cascade]
Ref: space_invitations.invited_by_user_id > users.id [delete: set null]

Ref: task_statuses.space_id > spaces.id [delete: cascade]
Ref: space_tags.space_id > spaces.id [delete: cascade]

Ref: tasks.space_id > spaces.id [delete: cascade]
Ref: tasks.creator_user_id > users.id [delete: set null]
Ref: tasks.assignee_user_id > users.id [delete: no action]

Ref: tasks.(space_id, assignee_user_id) > space_memberships.(space_id, user_id) [delete: no action]
Ref: tasks.(space_id, status_id) > task_statuses.(space_id, id) [delete: no action]

Ref: task_tags.(space_id, task_id) > tasks.(space_id, id) [delete: cascade]
Ref: task_tags.(space_id, tag_id) > space_tags.(space_id, id) [delete: cascade]

Ref: task_changes.task_id > tasks.id [delete: cascade]
Ref: task_changes.actor_user_id > users.id [delete: set null]
